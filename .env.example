# Provider Selection
LLM_PROVIDER=ollama
CHANNEL_PROVIDER=matrix

# Ollama Configuration (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://your-ollama-server:11434
OLLAMA_MODEL=qwen3:32b

# Google Gemini Configuration (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-2.5-flash
# Optional: override the default API base URL
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Mistral Configuration (if LLM_PROVIDER=mistral)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=mistral-large-latest
# Optional: override the default API base URL
# MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Matrix Configuration (if CHANNEL_PROVIDER=matrix)
MATRIX_HOMESERVER=https://matrix.org
MATRIX_USER_ID=@your-bot:matrix.org
MATRIX_ACCESS_TOKEN=your_access_token_here

# Security: Comma-separated list of allowed Matrix user IDs (leave empty to allow all)
# Example: @user1:matrix.org,@user2:matrix.org
MATRIX_ALLOWED_USERS=

# Security: Comma-separated list of allowed room IDs (leave empty to allow all rooms)
# Example: !roomid1:matrix.org,!roomid2:matrix.org
MATRIX_ALLOWED_ROOMS=

# Assistant Configuration
ASSISTANT_NAME=WORM Assistant
NAME=WORM Assistant
PERSONALITY=Helpful, concise, and direct.
BACKGROUND=A personal AI assistant focused on productivity.
SPEAKING_STYLE=Professional yet friendly, using clear and direct language.

# Conversation history length (number of recent messages to send)
MAX_HISTORY=5

# Dynamic context budgeting (tokens)
# Total tokens allowed for system prompt + history + tools per request
MAX_CONTEXT_TOKENS=16000
# Reserved tokens for the assistant's response (ensures headroom)
RESPONSE_TOKEN_BUFFER=1024
# Maximum tokens allocated to tool schemas per request
MAX_TOOL_CONTEXT_TOKENS=4000

# Memory Configuration
# Maximum number of facts to remember per user (older facts are automatically removed)
MEMORY_MAX_FACTS=10

# Tool Configuration: Comma-separated list of core tools (always loaded)
# Core tools are included in every request. Non-core tools load on-demand based on keywords.
# Example: get_current_time,calculate
CORE_TOOLS=get_current_time,calculate
# Maximum number of tools considered per turn (after semantic scoring)
MAX_TOOLS=8

# LLM logging toggle (set to false to disable request/response payload logging)
LLM_LOGGING=true

# Optional: override headless cron run log location (defaults to memory/cron-runs.log)
# CRON_RUN_LOG_PATH=/absolute/path/to/cron-runs.log

